{
    "name": "padosoft/laravel-ai-price-intelligence",
    "description": "Enterprise Product & Price Intelligence / Competitor Monitoring for Laravel — AI-native, EU AI Act-ready, self-hostable alternative to Netrivals and Competitoor.",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": [
        "laravel",
        "price-intelligence",
        "competitor-monitoring",
        "price-monitoring",
        "dynamic-pricing",
        "repricing",
        "ecommerce",
        "scraping",
        "ai",
        "product-matching",
        "marketplace",
        "amazon",
        "price-comparison"
    ],
    "authors": [
        {
            "name": "Lorenzo Padovani",
            "email": "lorenzo.padovani@padosoft.com",
            "homepage": "https://github.com/padosoft"
        }
    ],
    "homepage": "https://github.com/padosoft/laravel-ai-price-intelligence",
    "support": {
        "issues": "https://github.com/padosoft/laravel-ai-price-intelligence/issues",
        "source": "https://github.com/padosoft/laravel-ai-price-intelligence"
    },
    "require": {
        "php": "^8.3",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-json": "*",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/queue": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "padosoft/laravel-ai-search-providers": "^1.0 || dev-main"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^11.0 || ^12.0",
        "laravel/sanctum": "^4.0",
        "league/csv": "^9.0"
    },
    "suggest": {
        "laravel/sanctum": "Bearer token auth for the REST API (^4.0)",
        "laravel/horizon": "Queue dashboard and supervision for high-volume scraping",
        "league/csv": "CSV catalog import/export (^9.0)",
        "phpoffice/phpspreadsheet": "Excel catalog import",
        "spatie/browsershot": "Headless Chrome rendering driver for JS-heavy sites",
        "padosoft/laravel-pii-redactor": "GDPR PII redaction on scraped content (auto-wired when present)",
        "padosoft/laravel-ai-act-compliance": "EU AI Act governance bridge (auto-wired when present)",
        "stancl/tenancy": "Database-per-tenant mode for very large tenants"
    },
    "autoload": {
        "psr-4": {
            "Padosoft\\PriceIntelligence\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Padosoft\\PriceIntelligence\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Padosoft\\PriceIntelligence\\PriceIntelligenceServiceProvider"
            ],
            "aliases": {
                "PriceIntelligence": "Padosoft\\PriceIntelligence\\Facades\\PriceIntelligence"
            }
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=Unit",
        "test:feature": "phpunit --testsuite=Feature"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../laravel-ai-search-providers",
            "options": { "symlink": false }
        }
    ],
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
